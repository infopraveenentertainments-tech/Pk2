<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login | Praveen Kitkat</title><style>body{margin:0;background:#09090c;color:#eee;font-family:Inter,Arial;min-height:100vh;display:grid;place-items:center}.box{width:min(380px,90vw);background:#121216;border:1px solid #302c33;padding:35px}h1{font-family:Georgia,serif;color:#d7aa52}input{width:100%;box-sizing:border-box;padding:14px;background:#09090c;border:1px solid #403b43;color:#fff;margin:12px 0}button{width:100%;padding:14px;background:#d3a44e;border:0;font-weight:700;cursor:pointer}.error{color:#e47d7d;font-size:13px}</style></head><body><div class="box"><div>PRAVEEN <b style="color:#d7aa52">KITKAT</b></div><h1>Admin Dashboard</h1><p>Sign in to manage your website.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post"><input type="password" name="password" placeholder="Admin password" autofocus required><button>Sign in</button></form></div></body></html>