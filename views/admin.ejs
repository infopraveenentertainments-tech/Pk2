<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin | Praveen Kitkat</title><style>
*{box-sizing:border-box}body{margin:0;background:#09090c;color:#eee;font-family:Inter,Arial}.top{height:68px;padding:0 4vw;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #29262d;background:#0e0e12;position:sticky;top:0;z-index:5}.brand{font-family:Georgia,serif;letter-spacing:2px}.brand span,h2{color:#d7aa52}.top a{color:#aaa;text-decoration:none}.wrap{width:min(1250px,92vw);margin:30px auto}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.panel{background:#111115;border:1px solid #2a272e;padding:24px;margin-bottom:20px}.panel h2{font-family:Georgia,serif;margin-top:0}label{font-size:11px;color:#9b958d;display:block;margin:12px 0 6px}input,textarea,select{width:100%;padding:11px;background:#09090c;color:#eee;border:1px solid #37333b;border-radius:4px}textarea{min-height:100px}.btn{display:inline-block;padding:11px 15px;background:#d3a44e;color:#0a0907;border:0;font-weight:700;margin-top:12px;cursor:pointer}.danger{background:#54292b;color:#fff}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.item{border-top:1px solid #29262d;padding:14px 0;display:flex;justify-content:space-between;gap:12px;align-items:center}.thumb{width:70px;height:55px;object-fit:cover}.muted{color:#8d8880;font-size:12px}.status{padding:5px 8px;background:#28242b;border-radius:15px;font-size:11px}.wide{grid-column:1/-1}@media(max-width:800px){.grid{grid-template-columns:1fr}.row{grid-template-columns:1fr}}
</style></head><body>
<header class="top"><div class="brand">PRAVEEN <span>KITKAT</span> — ADMIN</div><div><a href="/" target="_blank">View website</a> &nbsp; | &nbsp; <form style="display:inline" method="post" action="/admin/logout"><button style="background:none;border:0;color:#aaa;cursor:pointer">Logout</button></form></div></header>
<div class="wrap">
<h1>Dashboard</h1><p class="muted">Manage your website content and incoming booking enquiries.</p>
<div class="grid">
<section class="panel"><h2>Website settings</h2><form method="post" action="/admin/settings" enctype="multipart/form-data">
<label>Name</label><input name="name" value="<%= settings.name %>" required>
<label>Tagline</label><input name="tagline" value="<%= settings.tagline %>" required>
<div class="row"><div><label>City</label><input name="city" value="<%= settings.city %>"></div><div><label>Phone</label><input name="phone" value="<%= settings.phone %>"></div></div>
<label>Instagram URL</label><input name="instagram" value="<%= settings.instagram %>">
<label>About</label><textarea name="about"><%= settings.about %></textarea>
<label>Hero image</label><input type="file" name="hero" accept="image/*">
<button class="btn">Save website settings</button></form></section>

<section class="panel"><h2>Add service</h2><form method="post" action="/admin/services/add" enctype="multipart/form-data">
<label>Title</label><input name="title" required><label>Description</label><textarea name="description" required></textarea><label>Image</label><input type="file" name="image" accept="image/*"><label>Order</label><input type="number" name="sort_order" value="0"><button class="btn">Add service</button></form>
<h3>Current services</h3><% services.forEach(s=>{ %><div class="item"><div><b><%= s.title %></b><div class="muted"><%= s.description %></div></div><form method="post" action="/admin/services/<%= s.id %>/delete"><button class="btn danger">Delete</button></form></div><% }) %></section>

<section class="panel"><h2>Add testimonial</h2><form method="post" action="/admin/testimonials/add"><label>Client name</label><input name="name" required><label>Review</label><textarea name="text" required></textarea><label>Rating</label><select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select><button class="btn">Add testimonial</button></form>
<h3>Current testimonials</h3><% testimonials.forEach(t=>{ %><div class="item"><div><b><%= t.name %></b><div class="muted">★★★★★ — <%= t.text %></div></div><form method="post" action="/admin/testimonials/<%= t.id %>/delete"><button class="btn danger">Delete</button></form></div><% }) %></section>

<section class="panel"><h2>Add gallery image</h2><form method="post" action="/admin/gallery/add" enctype="multipart/form-data"><label>Title</label><input name="title" value="Magic Show"><label>Image</label><input type="file" name="image" accept="image/*" required><label>Order</label><input type="number" name="sort_order" value="0"><button class="btn">Upload image</button></form>
<h3>Gallery</h3><% gallery.forEach(g=>{ %><div class="item"><div style="display:flex;gap:12px;align-items:center"><img class="thumb" src="/uploads/<%= g.image %>"><div><b><%= g.title %></b><div class="muted"><%= g.image %></div></div></div><form method="post" action="/admin/gallery/<%= g.id %>/delete"><button class="btn danger">Delete</button></form></div><% }) %></section>

<section class="panel wide" id="enquiries"><h2>Booking enquiries</h2><% if(!enquiries.length){ %><p class="muted">No enquiries yet.</p><% } %><% enquiries.forEach(e=>{ %><div class="item" style="align-items:flex-start"><div><b><%= e.name %></b> — <%= e.phone %><div class="muted"><%= e.event_type||"Event" %> • <%= e.event_date||"Date not given" %> • <%= e.location||"Location not given" %> • <%= e.guests||"Guests not given" %></div><p><%= e.message %></p><div class="muted"><%= e.created_at %></div></div><div><div class="status"><%= e.status %></div><form method="post" action="/admin/enquiries/<%= e.id %>/status"><select name="status"><option <%= e.status==="New"?"selected":"" %>>New</option><option <%= e.status==="Contacted"?"selected":"" %>>Contacted</option><option <%= e.status==="Confirmed"?"selected":"" %>>Confirmed</option><option <%= e.status==="Completed"?"selected":"" %>>Completed</option></select><button class="btn">Update</button></form></div></div><% }) %></section>
</div></div></body></html>