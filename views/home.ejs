<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<meta name="description" content="<%= settings.name %> - professional magician and entertainer in <%= settings.city %>.">

<title><%= settings.name %> | Magic & Entertainment</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
*{
box-sizing:border-box
}

html{
scroll-behavior:smooth
}

body{
margin:0;
background:#08080b;
color:#f4efe5;
font-family:Inter,Arial,sans-serif
}

a{
color:inherit
}

.nav{
position:fixed;
z-index:20;
top:0;
left:0;
right:0;
height:76px;
padding:0 6vw;
display:flex;
align-items:center;
justify-content:space-between;
background:rgba(8,8,11,.78);
backdrop-filter:blur(16px);
border-bottom:1px solid #252229
}

.brand{
font:700 18px Cinzel,serif;
letter-spacing:2px;
text-decoration:none
}

.brand span,
em,
.gold{
color:#d7aa52;
font-style:normal
}

.nav nav{
display:flex;
gap:26px;
align-items:center
}

.nav nav a{
text-decoration:none;
color:#c5c0b8;
font-size:13px
}

.nav nav a:hover{
color:#d7aa52
}

.cta{
border:1px solid #b88937;
padding:11px 16px;
border-radius:24px
}

.menu{
display:none;
background:none;
border:0;
color:#fff;
font-size:25px
}

.hero{
min-height:100vh;
padding:130px 7vw 70px;
display:grid;
grid-template-columns:1.05fr .95fr;
gap:5vw;
align-items:center;
background:
radial-gradient(
circle at 75% 30%,
rgba(130,78,18,.26),
transparent 35%
)
}

.eyebrow{
color:#d3a34e;
font-size:10px;
font-weight:700;
letter-spacing:3px
}

.hero h1,
h2{
font:600 clamp(42px,6vw,80px)/1.03 Cinzel,serif;
letter-spacing:-2px;
margin:18px 0
}

.lead{
color:#a9a49d;
line-height:1.8;
max-width:620px
}

.buttons{
display:flex;
gap:13px;
flex-wrap:wrap;
margin:28px 0
}

.btn{
display:inline-block;
padding:16px 23px;
border-radius:4px;
text-decoration:none;
font-weight:700;
font-size:13px
}

.primary{
background:#d3a44e;
color:#0b0a09
}

.ghost{
border:1px solid #514a40
}

.services{
color:#7f7971;
font-size:10px;
letter-spacing:2px
}

.hero-photo{
position:relative
}

.hero-photo img{
width:100%;
height:650px;
object-fit:cover;
position:relative;
z-index:1
}

.hero-photo:after{
content:"";
position:absolute;
inset:18px -18px -18px 18px;
border:1px solid #9b7435
}

.badge{
position:absolute;
z-index:2;
bottom:28px;
left:-25px;
width:95px;
height:95px;
border-radius:50%;
background:#0d0d10;
border:1px solid #d3a44e;
display:grid;
place-items:center;
text-align:center;
font:10px Cinzel,serif;
letter-spacing:1px
}

.strip{
overflow:hidden;
border-block:1px solid #242229;
padding:17px;
color:#ad8b51;
white-space:nowrap;
font:12px Cinzel,serif;
letter-spacing:3px
}

.strip span{
padding:0 16px;
color:#d7aa52
}

.section{
padding:110px 7vw
}

.head{
max-width:700px;
margin-bottom:50px
}

.head p:last-child{
color:#8d8881;
line-height:1.8
}

.cards{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px
}

.card{
background:#111115;
border:1px solid #252229;
overflow:hidden
}

.card img{
width:100%;
height:240px;
object-fit:cover
}

.card-body{
padding:23px
}

.card-body small{
color:#b88937
}

.card h3{
font:600 22px Cinzel,serif
